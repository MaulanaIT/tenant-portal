# Shared environment for every app in this repo.
# Copy to `.env` at the repo root: `cp .env.example .env`

# --- Database (docker-compose.yml + Prisma) ---
DB_USER=tenant_portal
DB_PASSWORD=tenant_portal
DB_NAME=tenant_portal
DB_PORT=5433
DATABASE_URL=postgresql://tenant_portal:tenant_portal@localhost:5433/tenant_portal?schema=public

# --- API (app/api) ---
# Port the NestJS server listens on
API_PORT=3000
API_HOST=
# Origin allowed by CORS (the portal's URL)
PORTAL_URL=http://localhost:3001
# Secret used to sign access tokens and how long they stay valid
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# --- Portal (app/portal) ---
# Port the Next.js server listens on
PORTAL_PORT=3001
PORTAL_HOST=
# Base URL of the API, exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:3000
